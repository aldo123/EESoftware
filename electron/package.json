{
  "name": "ee-interlock-electron",
  "version": "1.0.0",
  "description": "EE Interlock desktop application wrapper",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "clean": "node -e \"const fs=require('fs'); for(const p of ['../release','dist']) { try{fs.rmSync(p,{recursive:true,force:true});}catch(e){} } console.log('Electron build folders cleaned')\""
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.wik.eeinterlock",
    "productName": "EE Interlock",
    "asar": true,
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/main",
        "to": "backend"
      },
      {
        "from": "../frontend-updated/frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../backend/data",
        "to": "backend/data"
      },
      {
        "from": "../backend/pages",
        "to": "backend/pages"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EE-Interlock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EE Interlock"
    }
  }
}

  "notes": [
    {
      "id": "note_01",
      "x": 25,
      "y": 0,
      "w": 210,
      "h": 400,
      "title": "SENSOR START",
      "text": "Discrete input 10 rises 0 -> 1, only while IDLE: holding 2 = 0, then a 5 s countdown. The sensor must stay ON.",
      "color": "blue"
    },
    {
      "id": "note_02",
      "x": 25,
      "y": 520,
      "w": 210,
      "h": 290,
      "title": "COUNT BUBBLES",
      "text": "The camera counts bubbles for 5 s inside the ROI band (y 310-380). Count <= Max Bubbles = OK, otherwise NG.",
      "color": "orange"
    },
    {
      "id": "note_03",
      "x": 25,
      "y": 820,
      "w": 210,
      "h": 480,
      "title": "RESULT OK",
      "text": "Sensor still ON: holding 1 = 1, holding 2 = 1, OK/Total counters + one row in the SN List.",
      "color": "green"
    },
    {
      "id": "note_04",
      "x": 480,
      "y": 820,
      "w": 210,
      "h": 480,
      "title": "RESULT NG",
      "text": "Sensor still ON: holding 1 = 2, holding 2 = 1, NG/Total counters + one row in the SN List.",
      "color": "red"
    },
    {
      "id": "note_05",
      "x": 250,
      "y": 820,
      "w": 210,
      "h": 300,
      "title": "SENSOR LOST WHILE COUNTING",
      "text": "The sensor dropped before the count ended: FAIL screen, holding 1 = 3 (invalid), nothing is counted.",
